rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(d) {
      return signedIn() && d.data.ownerUid == request.auth.uid;
    }

    function creatingOwn() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    // User profile: seededAt, tagColors, and the autonomy policy
    // (users/{uid}.autonomy — the global kill switch + budget counter).
    // Strictly single-owner — no cross-user read, unlike the collections below.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /boards/{boardId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    match /lists/{listId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    match /cards/{cardId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    match /goals/{goalId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    match /templates/{templateId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    match /agents/{agentId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);
    }

    // Run records are created only in `queued` state by the client; the
    // engine's lease claim / settle writes are ordinary owner-scoped updates
    // (ownerUid immutable). Runs are never deleted.
    match /runs/{runId} {
      allow read: if owns(resource);
      allow create: if creatingOwn() && request.resource.data.status == 'queued';
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if false;
    }

    // Orchestrator conversation threads and their messages (Phase 6).
    match /threads/{threadId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);

      match /messages/{messageId} {
        allow read: if owns(resource);
        allow create: if creatingOwn();
        allow update: if owns(resource) && ownerUnchanged();
        allow delete: if owns(resource);
      }
    }

    // We3 guest share links: the unguessable token IS the capability. Anyone
    // can GET one share doc by id (never list) and read/post comments under
    // it; comments become unreadable the moment the share is revoked (the
    // parent-exists check). Only the owner creates, refreshes, or revokes.
    match /goalShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if creatingOwn();
      allow update: if owns(resource) && ownerUnchanged();
      allow delete: if owns(resource);

      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/goalShares/$(token));
        allow create: if exists(/databases/$(database)/documents/goalShares/$(token))
          && request.resource.data.keys().hasOnly(['author', 'text', 'createdAt'])
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Activity log is append-only: no update, no delete.
    match /activity/{activityId} {
      allow read: if owns(resource);
      allow create: if creatingOwn();
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
